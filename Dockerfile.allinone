# 一体化镜像：drawio webapp + export-server + svg-exporter + 主服务，单容器运行
# 构建:  docker build -f Dockerfile.allinone -t umeko-drawio-server .
# 运行:  docker run -d -p 3000:3000 -v $PWD/output:/app/output -v $PWD/data:/app/data umeko-drawio-server
FROM jgraph/drawio:latest AS drawio

FROM jgraph/export-server:latest

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl fontconfig \
 && rm -rf /var/lib/apt/lists/*

# Tomcat + drawio webapp（Java 应用，跨发行版直接复制）
COPY --from=drawio /usr/local/tomcat /usr/local/tomcat

# 主服务
WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi
COPY src ./src
COPY public ./public

# svg-exporter 脚本并入 export-server 应用目录（复用其 Chrome + puppeteer 依赖）
COPY exporter/svg-export.js /home/pptruser/draw-image-export2/svg-export.js

COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /app/output /app/data /usr/share/fonts/drawio

ENV NODE_ENV=production \
    PORT=3000 \
    CATALINA_HOME=/usr/local/tomcat

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s \
  CMD curl -fsS http://127.0.0.1:3000/healthz || exit 1

CMD ["/entrypoint.sh"]
